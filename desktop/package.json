{
  "name": "fileflex-desktop",
  "version": "1.0.0",
  "description": "Offline desktop app for FileFlex",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.fileflex.desktop",
    "productName": "FileFlex",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../out",
        "to": "out"
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "FileFlex-${version}-portable-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
